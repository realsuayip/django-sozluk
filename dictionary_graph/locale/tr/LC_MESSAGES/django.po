msgstr "işleminizi gerçekleştiremedik. daha sonra tekrar deneyin."

#: dictionary_graph/category/action.py:61
msgid ""
"you have used up all the suggestion claims you have today. try again later."
msgstr ""
"bugün kanal önerme haklarınızın hepsini kullandınız. daha sonra tekrar "
"deneyin."

#: dictionary_graph/category/action.py:77
#, python-format
msgid "you can only suggest %(count)d channel per topic."
msgid_plural "you can only suggest %(count)d channels per topic."
msgstr[0] "başlık başına en fazla %(count)d kanal önerebilirsiniz."
msgstr[1] "başlık başına en fazla %(count)d kanal önerebilirsiniz."

#: dictionary_graph/entry/action.py:56
msgid "your entry has been deleted"
msgstr "entry silindi"

#: dictionary_graph/entry/action.py:66
msgid "this entry is now pinned"
msgstr "entry sabitlendi"

#: dictionary_graph/entry/action.py:71
msgid "this entry is no longer pinned"
msgstr "entry artık sabit değil"

#: dictionary_graph/entry/action.py:93
msgid "the entry has been removed from favorites"
msgstr "entry favorilerden çıkarıldı"

#: dictionary_graph/entry/action.py:97
msgid "the entry has been favorited"
msgstr "entry favorilendi"

#: dictionary_graph/entry/edit.py:36
msgid "your changes have been saved as draft"
msgstr "değişiklikleriniz kenara kaydedildi"

#: dictionary_graph/entry/edit.py:53
msgid "your entry has been saved as draft"
msgstr "entry'niz kenara kaydedildi."

#: dictionary_graph/messaging/action.py:74
msgid "can't you write down something more?"
msgstr "çeşke bi şeyler yazsaydın"

#: dictionary_graph/messaging/action.py:80
msgid "no such person though"
msgstr "öyle biri yok"

#: dictionary_graph/messaging/action.py:87
msgid "we couldn't send your message"
msgstr "mesajınızı gönderemedik ne yazık ki"

#: dictionary_graph/messaging/action.py:89
msgid "your message has been successfully sent"
msgstr "mesajınız sağ salim gönderildi"

#. Translators: Include an emoji
#: dictionary_graph/messaging/action.py:111
msgid "this message was deleted 🤷‍"
msgstr "bu mesaj silinmiş 🤷‍"

#: dictionary_graph/topic/action.py:28
msgid "you no longer follow this topic"
msgstr "takipten çıkıldı"

#: dictionary_graph/topic/action.py:31
msgid "you are now following this topic"
msgstr "bu başlık takipte"

#: dictionary_graph/topic/action.py:48
msgid "sorry, the genie is now busy"
msgstr "sen ukte verme lütfen"

#: dictionary_graph/topic/action.py:66
msgid "your wish has been deleted"
msgstr "ukteniz silindi"

#: dictionary_graph/topic/action.py:71
msgid ""
"your wish is now enlisted. if someone starts a discussion, we will let you "
"know."
msgstr "ukteniz verildi. birileri bir şey yazarsa haber göndeririz."

#: dictionary_graph/user/action.py:45
msgid "removed blockages"
msgstr "engeller ortadan kalktı"

#: dictionary_graph/user/action.py:51
msgid "the person is now blocked"
msgstr "engelledim gitti"

#: dictionary_graph/user/action.py:67
msgid "you no longer follow this person"
msgstr "takipten çıkıldı"

#: dictionary_graph/user/action.py:70
msgid "you are now following this user"
msgstr "takiptesin"

